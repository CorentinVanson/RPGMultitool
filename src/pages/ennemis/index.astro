---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const enemies = await getCollection('enemies');
---
<Layout title="Ennemis">
  <h1>Bestiaire</h1>
  <div class="grid">
    {enemies.map((e) => (
      <div class="card">
        {e.data.image && <img src={e.data.image} alt={e.data.name} />}
        <h3><a href={`/ennemis/${e.id}`}>{e.data.name}</a></h3>
        <p><em>{e.data.type}</em></p>
        <p>DD (CR) {e.data.cr} — CA {e.data.ac} — PV {e.data.hp}</p>
        <p>{e.data.summary}</p>
      </div>
    ))}
  </div>
</Layout>
