---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const npcs = await getCollection('npcs');
---
<Layout title="Personnages">
  <h1>Personnages non-joueurs</h1>
  <div class="grid">
    {npcs.map((npc) => (
      <div class="card">
        {npc.data.image && <img src={npc.data.image} alt={npc.data.name} />}
        <h3><a href={`/personnages/${npc.id}`}>{npc.data.name}</a></h3>
        <p><em>{npc.data.role}</em></p>
        {npc.data.faction && <p class="tag">{npc.data.faction}</p>}
        <p>{npc.data.summary}</p>
      </div>
    ))}
  </div>
</Layout>
