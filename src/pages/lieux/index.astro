---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const locations = await getCollection('locations');
---
<Layout title="Lieux">
  <h1>Lieux importants</h1>
  <div class="grid">
    {locations.map((loc) => (
      <div class="card">
        {loc.data.image && <img src={loc.data.image} alt={loc.data.name} />}
        <h3><a href={`/lieux/${loc.id}`}>{loc.data.name}</a></h3>
        <p><em>{loc.data.type} — {loc.data.region}</em></p>
        <p>{loc.data.summary}</p>
        <div>{loc.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
      </div>
    ))}
  </div>
</Layout>
