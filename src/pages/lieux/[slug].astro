---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const locations = await getCollection('locations');
  return locations.map((loc) => ({ params: { slug: loc.id }, props: { loc } }));
}

const { loc } = Astro.props;
const { Content } = await render(loc);
---
<Layout title={loc.data.name}>
  <p><a href="/lieux">&larr; Retour aux lieux</a></p>
  {loc.data.image && <img src={loc.data.image} alt={loc.data.name} style="width:100%; border-radius: 6px;" />}
  <h1>{loc.data.name}</h1>
  <p><em>{loc.data.type} — {loc.data.region}</em></p>
  <div>{loc.data.tags.map((t: string) => <span class="tag">{t}</span>)}</div>
  <Content />
</Layout>
