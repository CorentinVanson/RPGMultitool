---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const arcs = (await getCollection('arcs')).sort((a, b) => a.data.order - b.data.order);
---
<Layout title="Campagne">
  <h1>La campagne : Les Marches de Gratigna</h1>
  <p>~20 sessions réparties en 3 arcs, avec embranchements narratifs d'un arc à l'autre.</p>
  <div class="grid">
    {arcs.map((arc) => (
      <div class="card">
        <h3><a href={`/campagne/${arc.id}`}>{arc.data.title}</a></h3>
        <p><em>{arc.data.sessions}</em></p>
        <p>{arc.data.summary}</p>
      </div>
    ))}
  </div>
</Layout>
