{
  "name": "rpgmultitool",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-content.mjs && node scripts/generate-music-manifest.mjs && nuxt dev",
    "start": "node .output/server/index.mjs",
    "build": "node scripts/generate-content.mjs && node scripts/generate-music-manifest.mjs && nuxt build",
    "preview": "nuxt preview"
    ,"db:seed": "node --env-file-if-exists=.env.local scripts/seed-database.mjs"
    ,"db:seed:local": "node scripts/seed-database.mjs --local"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "gray-matter": "^4.0.3",
    "h3": "^1.15.11",
    "marked": "^15.0.7",
    "nitropack": "^2.12.4",
    "nuxt": "^4.5.2",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@vite-pwa/nuxt": "1.1.1",
    "typescript": "^5.7.0",
    "vue-tsc": "^3.3.11"
  }
}
